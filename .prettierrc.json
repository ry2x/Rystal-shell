{
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "quoteProps": "as-needed",
  "arrowParens": "avoid",
  "bracketSpacing": false,
  "trailingComma": "es5",

  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": ["^ags.*$", "^gi://.*$", ".*\\.scss$", "^[./]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
